<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.LockApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="lockAppDarkBackground">false</item>

        <!-- Keypad palette: follows the theme (these colours have night values). -->
        <item name="lockKeySurface">@color/surface_raised</item>
        <item name="lockKeyStroke">@color/hairline</item>
        <item name="lockKeyText">@color/text_primary</item>
        <item name="lockKeyMuted">@color/text_secondary</item>
        <item name="lockAccentColor">@color/accent</item>
        <item name="lockAccentSurface">@color/accent_surface</item>
        <item name="lockAccentStroke">@color/accent_border</item>
        <item name="lockDotColor">@color/text_primary</item>
        <item name="lockErrorColor">@color/error</item>
        <item name="lockSubtleText">@color/text_tertiary</item>

        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryDark">@color/ground</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/hairline_strong</item>
        <item name="colorError">@color/error</item>

        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>

        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="fontFamily">@font/instrument_sans</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.LockApp.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.LockApp.BodyMedium</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.LockApp.TitleMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.LockApp.LabelLarge</item>

        <!-- Android 16 ignores this for apps targeting SDK 36, so insets are applied in
             code instead (see Insets.kt). Kept for Android 15, where it still works. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Full-screen, always-dark theme for the lock screen shown over other apps. -->
    <style name="Theme.LockApp.Lock" parent="Theme.LockApp">
        <item name="lockAppDarkBackground">true</item>

        <!-- Pinned dark, whatever the app theme is. -->
        <item name="lockKeySurface">@color/lock_surface</item>
        <item name="lockKeyStroke">@color/lock_hairline</item>
        <item name="lockKeyText">@color/lock_text</item>
        <item name="lockKeyMuted">@color/lock_text_secondary</item>
        <item name="lockAccentColor">@color/lock_accent</item>
        <item name="lockAccentSurface">@color/lock_accent_surface</item>
        <item name="lockAccentStroke">@color/lock_accent_border</item>
        <item name="lockDotColor">@color/lock_text</item>
        <item name="lockErrorColor">@color/lock_error</item>
        <item name="lockSubtleText">@color/lock_text_tertiary</item>
        <item name="colorPrimary">@color/lock_accent</item>
        <item name="colorOnPrimary">@color/lock_on_accent</item>
        <item name="android:windowBackground">@color/lock_bg</item>
        <item name="android:statusBarColor">@color/lock_bg</item>
        <item name="android:navigationBarColor">@color/lock_bg</item>
        <item name="android:textColorPrimary">@color/lock_text</item>
        <item name="android:textColorSecondary">@color/lock_text_secondary</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Launch (splash) theme. installSplashScreen() swaps to Theme.LockApp after launch. -->
    <style name="Theme.LockApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LockApp</item>
    </style>

    <!-- ===== Type ===== -->

    <style name="TextAppearance.LockApp.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="fontFamily">@font/instrument_sans</item>
    </style>

    <style name="TextAppearance.LockApp.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="fontFamily">@font/instrument_sans</item>
    </style>

    <style name="TextAppearance.LockApp.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="fontFamily">@font/instrument_sans</item>
    </style>

    <style name="TextAppearance.LockApp.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="fontFamily">@font/instrument_sans</item>
    </style>

    <!-- The wordmark and the one headline that carries the brand. -->
    <style name="Wordmark">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/instrument_serif_regular</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Display" parent="Wordmark">
        <item name="android:textSize">38sp</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
    </style>

    <style name="ScreenTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/instrument_sans_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Small caps label above a group. -->
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingTop">26dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- ===== Controls ===== -->

    <style name="PinKey" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">66dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textColor">?attr/lockKeyText</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">#1FFFFFFF</item>
    </style>

    <style name="PrimaryPill" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="cornerRadius">27dp</item>
        <item name="elevation">0dp</item>
    </style>



    <!-- A prompt that needs the user to go and fix something (a missing permission,
         battery optimisation). Amber, because it is a warning, not a feature. -->
    <style name="AlertRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">24dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_card_warning</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">13dp</item>
        <item name="android:drawableStart">@drawable/ic_shield_check</item>
        <item name="android:drawableTint">@color/warning</item>
        <item name="android:drawablePadding">11dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/warning_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ===== Settings rows ===== -->

    <style name="SettingsHeader" parent="SectionLabel" />

    <!-- Rows live inside a bordered group rather than running edge to edge. -->
    <style name="CardGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">24dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <style name="RowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/hairline</item>
    </style>

    <style name="RowChevron">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:tint">@color/text_tertiary</item>
    </style>


    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">62dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="SettingsRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/instrument_sans_medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="SettingsRowSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>
