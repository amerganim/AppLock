    <!-- Tamper -->
    <string name="tamper_switch">Block uninstall &amp; lock Settings</string>
    <string name="tamper_desc">Locks the Settings app and registers a device administrator so LockApp can\'t be easily uninstalled. You\'ll need your lock to open Settings.</string>
    <string name="admin_active">Uninstall is blocked (device admin active).</string>
    <string name="admin_inactive">Device admin not active — uninstall is not blocked.</string>
    <string name="admin_description">Lets LockApp resist being uninstalled until you turn off tamper protection with your lock.</string>
    <string name="admin_explanation">Activate so LockApp cannot be uninstalled without your lock. To remove LockApp later, turn off Tamper protection inside the app first.</string>
    <string name="admin_disable_warning">Turn off Tamper protection inside LockApp (with your lock) instead. Disabling here allows LockApp to be uninstalled.</string>

