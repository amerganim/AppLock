<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keypadGrid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:columnCount="3"
    android:rowCount="4"
    android:useDefaultMargins="false">

    <Button android:id="@+id/btn1" style="@style/PinKey" android:text="1" />
    <Button android:id="@+id/btn2" style="@style/PinKey" android:text="2" />
    <Button android:id="@+id/btn3" style="@style/PinKey" android:text="3" />

    <Button android:id="@+id/btn4" style="@style/PinKey" android:text="4" />
    <Button android:id="@+id/btn5" style="@style/PinKey" android:text="5" />
    <Button android:id="@+id/btn6" style="@style/PinKey" android:text="6" />

    <Button android:id="@+id/btn7" style="@style/PinKey" android:text="7" />
    <Button android:id="@+id/btn8" style="@style/PinKey" android:text="8" />
    <Button android:id="@+id/btn9" style="@style/PinKey" android:text="9" />

    <!-- Submits a variable-length PIN. Hidden while unlocking, where the saved length
         is known and the PIN submits itself as soon as it is complete. -->
    <Button
        android:id="@+id/btnOk"
        style="@style/PinKey"
        android:contentDescription="@string/confirm"
        android:text="✓"
        android:visibility="invisible" />

    <Button android:id="@+id/btn0" style="@style/PinKey" android:text="0" />

    <Button
        android:id="@+id/btnDelete"
        style="@style/PinKey"
        android:contentDescription="@string/delete"
        android:text="⌫" />
</GridLayout>
